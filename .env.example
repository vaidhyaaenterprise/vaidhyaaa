# ==================================================
# Vaidya Root Environment Example
# Copy this file to your local .env or app-specific env files.
# Never commit real .env files.
# ==================================================

# ----------------------------
# Runtime
# ----------------------------
NODE_ENV=development
# Use qa/staging/production on shared servers. Those environments reject local databases.
APP_ENV=qa

# ----------------------------
# Ports
# ----------------------------
API_PORT=3000
WEB_PORT=3001

# ----------------------------
# Database
# Supabase PostgreSQL connection. Replace every placeholder before starting the app.
# ----------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Integration tests use pgvector Postgres on port 5433 (see `pnpm db:test:up`)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vaidya_test

# Supabase project metadata. The publishable key is for browser Realtime only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# ----------------------------
# Redis / Queue
# Optional in local. Required later for production jobs.
# ----------------------------
REDIS_URL=
QUEUE_MODE=inline
JOB_WORKER_ENABLED=false

# ----------------------------
# Auth
# local/dev = dev auth
# qa/prod = otp / supabase / jwt provider
# ----------------------------
AUTH_MODE=dev
JWT_SECRET=dev_only_change_me

DEV_CLINIC_ID=
DEV_USER_ID=
DEV_USER_ROLE=clinic_admin
DEV_DOCTOR_ID=

# ----------------------------
# Email delivery — used for verification codes and password resets.
# Brevo SMTP is preferred; Resend remains an optional fallback.
# Provider credentials stay backend-only; never commit real values.
# ----------------------------
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="Vaidya <noreply@yourdomain.com>"
# SMTP (Brevo) - preferred provider.
# SMTP_PASS is the Brevo SMTP key; never commit the real value.
# @vaidya/api/.env (real values) is gitignored; these placeholders are safe to commit.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key

# ----------------------------
# API / Web
# ----------------------------
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3001

# ----------------------------
# LLM / Agent
# Use mock first. Real provider comes later.
# ----------------------------
PRIMARY_LLM_PROVIDER=mock
PRIMARY_LLM_MODEL=sarvam-30b
FALLBACK_LLM_MODEL=sarvam-105b
LLM_TIMEOUT_MS=20000
LLM_ENABLE_FALLBACK=true
LLM_LATENCY_MODE=auto
LLM_FAST_CHANNELS=web_demo,voice_call,admin_test
LLM_FAST_TIMEOUT_MS=5000
LLM_FAST_ENABLE_FALLBACK=false
LLM_FAST_MAX_OUTPUT_TOKENS=280
LLM_SERVICE_ROUTER_MEMORY_CACHE_TTL_SEC=3600
LLM_LOG_RAW=false
SERVICE_ROUTER_PROVIDER=mock

# ----------------------------
# Knowledge / Embeddings (A09)
# ----------------------------
KNOWLEDGE_SEARCH_PROVIDER=text
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-v1
EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_VECTOR_MIN_SCORE=0.70
KNOWLEDGE_VECTOR_MAX_RESULTS=5
KNOWLEDGE_VECTOR_USE_HYBRID_FALLBACK=true

SARVAM_API_KEY=
SARVAM_AUTH_MODE=subscription

# ----------------------------
# Speech / Voice
# Voice comes later. Keep mock in early stages.
# ----------------------------
STT_PROVIDER=mock
TTS_PROVIDER=mock
TELEPHONY_PROVIDER=mock

STT_MODEL=
TTS_MODEL=

# ----------------------------
# Messaging
# WhatsApp/SMS provider comes later.
# ----------------------------
MESSAGING_PROVIDER=mock

# ----------------------------
# Object Storage
# For call recordings later.
# Do not store MP3/audio in Postgres.
# ----------------------------
OBJECT_STORAGE_PROVIDER=mock
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_ENDPOINT=

# ----------------------------
# Retention Defaults
# ----------------------------
DEFAULT_RECORDING_RETENTION_DAYS=10
DEFAULT_TRANSCRIPT_RETENTION_DAYS=30

# ----------------------------
# Debug
# ----------------------------
DEBUG_API=true
LOG_LEVEL=debug
