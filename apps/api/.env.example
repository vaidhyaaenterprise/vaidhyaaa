NODE_ENV=development
APP_ENV=qa
API_PORT=3000
CORS_ORIGINS=http://localhost:3001
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
#DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vaidya_test
JWT_SECRET=dev_only_change_me
AUTH_MODE=dev
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_CLINIC_ID=00000000-0000-0000-0000-000000000001
DEV_USER_ROLE=clinic_admin
API_BASE_URL=http://localhost:3000
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM="Vaidya <noreply@yourdomain.com>"
# SMTP (Brevo) - preferred provider.
# SMTP_PASS is the Brevo SMTP key; never commit the real value.
# @vaidya/api/.env (real values) is gitignored; these placeholders are safe to commit.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
LOG_LEVEL=debug
DEBUG_API=true
JOB_WORKER_ENABLED=false
QUEUE_MODE=inline
OBJECT_STORAGE_PROVIDER=mock
PRIMARY_LLM_PROVIDER=mock
PRIMARY_LLM_MODEL=sarvam-30b
FALLBACK_LLM_MODEL=sarvam-105b
LLM_TIMEOUT_MS=20000
LLM_ENABLE_FALLBACK=true
LLM_LATENCY_MODE=auto
LLM_FAST_CHANNELS=web_demo,voice_call,admin_test
LLM_FAST_TIMEOUT_MS=5000
LLM_FAST_ENABLE_FALLBACK=false
LLM_FAST_MAX_OUTPUT_TOKENS=280
LLM_SERVICE_ROUTER_MEMORY_CACHE_TTL_SEC=3600
LLM_LOG_RAW=false
SERVICE_ROUTER_PROVIDER=mock
CONVERSATION_AGENT_MODE=agent
RECEPTIONIST_AGENT_PROVIDER=sarvam
RECEPTIONIST_AGENT_MODEL=sarvam-30b
RECEPTIONIST_AGENT_FALLBACK_MODEL=sarvam-105b
RECEPTIONIST_AGENT_TIMEOUT_MS=2000
RECEPTIONIST_AGENT_TURN_BUDGET_MS=8000
RECEPTIONIST_AGENT_MAX_TOKENS=420
RECEPTIONIST_AGENT_MAX_TOOL_ROUNDS=4
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
SARVAM_AUTH_MODE=subscription
STT_PROVIDER=mock
TTS_PROVIDER=mock
TELEPHONY_PROVIDER=mock
MESSAGING_PROVIDER=mock
